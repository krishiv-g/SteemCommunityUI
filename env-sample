# Copy this file to .env and fill in your own values.

# Steem community ID (e.g. hive-185836)
COMMUNITY_ID="hive-000000"

# Public URL of your deployed site
SITE_URL="https://your-community-site.com"
VITE_SITE_URL="https://your-community-site.com"

# Supabase — get these from your Supabase project settings
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite-prefixed copies (required for browser access)
VITE_COMMUNITY_ID="hive-000000"
VITE_COMMUNITY_TAGLINE="Your community tagline here."
VITE_STEEM_RPC_NODES="https://api.steemit.com,https://api.justyy.com"
VITE_STEEM_RPC_TIMEOUT="8000"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
